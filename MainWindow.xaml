<Window x:Class="TaskManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Management" Height="470" Width="1020"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- StackPanel for search and filter options -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Height="434">
            <TextBlock Text="Search:" Margin="5"/>
            <TextBox Name="SearchTextBox" Width="120" Margin="5" TextChanged="SearchTextBox_TextChanged"  />

            <TextBlock Text="Filter by Due Date:" Margin="5"/>
            <StackPanel Orientation="Vertical">
                <DatePicker Name="StartDatePicker" Width="115" Margin="5" SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>
                <TextBlock Text="                to" VerticalAlignment="Center" Margin="5" />
                <DatePicker Name="EndDatePicker" Width="115" Margin="5" RenderTransformOrigin="0.663,19.715" SelectedDateChanged="EndDatePicker_SelectedDateChanged"/>
            </StackPanel>

            <TextBlock Text="Filter by Priority:" Margin="5"/>
            <ComboBox Name="PriorityFilterComboBox" Width="120" Margin="5" SelectionChanged="PriorityFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="High"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="Low"/>
            </ComboBox>

            <TextBlock Text="Filter by Category:" Margin="5"/>
            <ComboBox Name="CategoryFilterComboBox" Width="120" Margin="5" SelectionChanged="CategoryFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Work"/>
                <ComboBoxItem Content="Personal"/>
                <ComboBoxItem Content="Urgent"/>
            </ComboBox>

            <!-- Spacer to move buttons lower -->
            <TextBlock Height="10" Margin="5"/>

            <Button Content="Add Task" Width="100" Margin="5" Click="AddTask_Click"/>
            <Button Content="Edit Task" Width="100" Margin="5" Click="EditTask_Click"/>
            <Button Content="Delete Task" Width="100" Margin="5" Click="DeleteTask_Click"/>
      
        </StackPanel>

        <TextBlock Height="10" Grid.Column="2"/>
        <StackPanel Grid.Column="1" Margin="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ListView Name="TaskListView" Height="200"  ItemsSource="{Binding taskList}" SelectedItem="{Binding SelectedTask}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Column="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="200"/>
                            <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="275"/>
                            <GridViewColumn Header="Due Date" Width="155">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}" Width="100"/>
                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="110"/>
                            <GridViewColumn Header="Actions" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Complete" Click="CompleteTask_Click"  Tag="{Binding}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>

                </ListView>
            </ScrollViewer>


            <TextBlock Text="COMPLETED TASKS" FontWeight="Bold" Height="20" Margin="5" HorizontalAlignment="Center"/>

            <!-- ListView for completed tasks -->
            <ScrollViewer>
                <ListView Name="CompletedTaskListView" Height="200" VerticalAlignment="Top" ItemsSource="{Binding CompletedTasks}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="200"/>
                            <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="275"/>
                            <GridViewColumn Header="Due Date" Width="155">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}" Width="100"/>
                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="110"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>

        </StackPanel>

    </Grid>
</Window>