<Window x:Class="TaskManagement.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagement"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <TextBlock FontSize="20" Margin="200,200,0,0">Username:</TextBlock>
        <TextBlock></TextBlock>
        <TextBlock FontSize="20" Margin="200,230,0,0">Password:</TextBlock>
        <TextBox Name="User" FontSize="20" Margin="175,0,0,0" Height="25" Width="150"></TextBox>
        <PasswordBox Name="Pass" FontSize="20" Margin="175,60,0,0" Height="25" Width="150" ></PasswordBox>
        <Button Height="25" Width="100" Margin="175,200,0,0" Click="Login">Login</Button>
        <Button Height="25" Width="100" Margin="-300,200,0,0" Click="Create">Sign up</Button>
        
    </Grid>
</Window>
