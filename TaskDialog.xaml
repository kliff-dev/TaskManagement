<Window x:Class="TaskManagement.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Dialog" Height="320" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Title:"/>
            <TextBox Name="TitleTextBox" Margin="0,0,0,10"/>
            <TextBlock Text="Description:"/>
            <TextBox Name="DescriptionTextBox" Margin="0,0,0,10"/>
            <TextBlock Text="Due Date:"/>
            <DatePicker Name="DueDatePicker" Margin="0,0,0,10"/>
            <TextBlock Text="Priority:"/>
            <ComboBox Name="PriorityComboBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Low"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="High"/>
            </ComboBox>
            <TextBlock Text="Category:"/>
            <ComboBox Name="CategoryComboBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Work"/>
                <ComboBoxItem Content="Personal"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="75" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="75" Click="CancelButton_Click" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>