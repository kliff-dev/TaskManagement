<Window x:Class="TaskManagement.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagement"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800">
    <Grid>
        <ListView x:Name="UsersListView" Width="300" Height="250" Margin="50,50,50,50">
            <!-- Define the View for the ListView (GridView) -->
            <ListView.View>
                <GridView>
                    <!-- Define each column in the GridView -->
                    <GridViewColumn Header="UserID" DisplayMemberBinding="{Binding UserID}" Width="100" />
                    <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Username}" Width="100" />
                    <GridViewColumn Header="Password" DisplayMemberBinding="{Binding Password}" Width="100" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button Width="100" Height="50" Margin="-120,300,0,0" Click="Button_Click_1">View Task</Button>
        <Button Width="100" Height="50" Margin="100,300,0,0" Click="Button_Click">Delete</Button>
        <TextBlock Name="Z" FontSize="20" Width="20" Height="20" VerticalAlignment="Top"></TextBlock>
    </Grid>
    
</Window>
